# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Optional: Default output folder for markdown tickets (defaults to ./tickets)
OUTPUT_PATH=./tickets

# Bitbucket pull-request board (http://localhost:3099/repositories)
# The token needs Bitbucket scopes: read:repository:bitbucket, read:pullrequest:bitbucket, read:pipeline:bitbucket.
# BITBUCKET_EMAIL falls back to ORCA_BITBUCKET_EMAIL, then JIRA_EMAIL.
# BITBUCKET_API_TOKEN falls back to ORCA_BITBUCKET_API_TOKEN. A Jira-only token cannot read pull requests.
BITBUCKET_EMAIL=your-email@example.com
BITBUCKET_API_TOKEN=your-bitbucket-scoped-api-token
# Set REPOSITORIES to the slugs to watch. BITBUCKET_USERS limits the board to open
# pull requests authored by those emails or Bitbucket display names.
REPOSITORIES=gch-account-service-sdk,gch-auth0,gch-brand-service,ubid-frontend,scr-backend,scr-frontend,rcs-frontend,rcs-backend,ubid-backend
BITBUCKET_USERS=person@example.com
BITBUCKET_WORKSPACE=gchtech
